<Window x:Class="NysLottery.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NYS Lottery Native"
        Height="760" Width="1080" MinHeight="650" MinWidth="800"
        Background="#F1F4F1" FontFamily="Segoe UI" Foreground="#1E302C"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#08765C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#263C36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#172E2A" Foreground="White" Padding="8,3">
            <MenuItem Header="File">
                <MenuItem Header="Exit" Foreground="#1E302C" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Check for Updates" Foreground="#1E302C" Click="CheckUpdates_Click" />
                <Separator />
                <MenuItem x:Name="AboutMenuItem" Header="About" Foreground="#1E302C" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="#172E2A" BorderBrush="#E6B94F" BorderThickness="0,0,0,4" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NEW YORK" Foreground="#E6B94F" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="Lottery Picker" Foreground="White" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <Image x:Name="BrandingLogoImage" Grid.Column="1" Width="58" Height="58" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#D9E3DD" BorderThickness="0,0,0,1" Padding="24,14">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="GAME" FontSize="11" FontWeight="Bold" Foreground="#586C64" Margin="0,0,0,5" />
                        <ComboBox x:Name="GameComboBox" Width="225" Height="36" DisplayMemberPath="Name" SelectionChanged="GameComboBox_SelectionChanged" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="PICKS" FontSize="11" FontWeight="Bold" Foreground="#586C64" Margin="0,0,0,5" />
                        <TextBox x:Name="PickCountTextBox" Width="65" Height="36" Text="5" Padding="10,0" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <Button Content="Generate Picks" Style="{StaticResource ActionButton}" Click="Generate_Click" Margin="0,20,10,4" MinHeight="36" />
                    <Button Content="Refresh Results" Style="{StaticResource ActionButton}" Background="#E5EDE8" Foreground="#1D4B3F" Click="RefreshResults_Click" Margin="0,20,0,4" MinHeight="36" />
                </WrapPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="24,12,24,10">
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="#53695F" FontSize="12" TextWrapping="Wrap" />
                <ProgressBar x:Name="UpdateProgressBar" Height="12" Minimum="0" Maximum="100" Margin="0,6,0,0" Foreground="#08765C" Visibility="Collapsed" />
                <TextBlock x:Name="UpdateProgressText" Foreground="#53695F" Margin="0,4,0,0" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Background="White" BorderBrush="#D9E3DD" BorderThickness="1" CornerRadius="5" Margin="0,0,14,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="#E5EBE7" BorderThickness="0,0,0,1" Padding="16,14">
                            <TextBlock Text="YOUR PICKS" FontSize="13" FontWeight="Bold" Foreground="#245647" />
                        </Border>
                        <ListBox x:Name="ResultsListBox" FontFamily="Consolas" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#DFF1E5" BorderBrush="#B5D9C1" BorderThickness="1" CornerRadius="5" Padding="18,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="PrizeLabelText" FontSize="12" FontWeight="Bold" Foreground="#27654C" Text="Jackpot" />
                            <TextBlock x:Name="CurrentPrizeText" FontSize="26" FontWeight="Bold" Foreground="#174434" Text="$0" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" BorderBrush="#D9E3DD" BorderThickness="1" CornerRadius="5" Margin="0,0,0,14">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="#E5EBE7" BorderThickness="0,0,0,1" Padding="16,14">
                                <TextBlock Text="PAST WINNING NUMBERS" FontSize="13" FontWeight="Bold" Foreground="#245647" />
                            </Border>
                            <ListBox x:Name="WinningNumbersListBox" FontFamily="Consolas" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Background="White" BorderBrush="#D9E3DD" BorderThickness="1" CornerRadius="5">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="#E5EBE7" BorderThickness="0,0,0,1" Padding="16,12">
                                <TextBlock Text="PICK HISTORY" FontSize="13" FontWeight="Bold" Foreground="#245647" />
                            </Border>
                            <TextBox x:Name="HistoryTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="#53695F" FontFamily="Consolas" Padding="12,8"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
